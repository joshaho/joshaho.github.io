---
import { html } from "index.json";
import Layout from "@/layouts/Layout.astro";

import Header from "@/components/sections/Header.astro";
import Socials from "@/components/sections/Socials.astro";
import Featured from "@/components/sections/Featured.astro";
import Buttons from "@/components/sections/Buttons.astro";
import Articles from "@/components/sections/Articles.astro";

const showWriting = (html as { writing?: boolean }).writing !== false;
---

<Layout>
  <main>
    <Header />
    <Socials />
    <Featured />
    <Buttons />
    {showWriting && <Articles />}
  </main>
</Layout>

<style>
  main {
    width: 100%;
  }
</style>
