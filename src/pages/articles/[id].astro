---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, tags } = entry.data;
---

<Layout title={`${title} – Josha Ho`}>
  <main class="wrap">
    <a class="back" href="/articles/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg
      >
      All writing
    </a>

    <article>
      <header>
        <time datetime={pubDate.toISOString()}>
          {
            pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  .wrap {
    max-width: 680px;
    margin: 0 auto;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
    transition: color 0.25s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  header time {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tags {
    display: inline-flex;
    gap: 0.4rem;
    margin-left: 0.75rem;
  }

  .tags li {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
  }

  h1 {
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.2;
    padding-top: 0.85rem;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.6;
    text-wrap: pretty;
    margin: 0.9rem 0 0;
  }

  .prose {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .prose :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 2.25rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 1.75rem 0 0.6rem;
  }

  .prose :global(p) {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 1.1rem;
    text-wrap: pretty;
  }

  .prose :global(ul),
  .prose :global(ol) {
    list-style: disc outside;
    padding-left: 1.35rem;
    margin: 0 0 1.1rem;
  }

  .prose :global(ol) {
    list-style: decimal outside;
  }

  .prose :global(li) {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 0.35rem;
  }

  .prose :global(a) {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(45, 212, 191, 0.35);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.35rem 1.25rem;
    border-left: 2px solid var(--accent);
    background: var(--surface);
    border-radius: 0 10px 10px 0;
  }

  .prose :global(blockquote p) {
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.85em;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15em 0.45em;
    border-radius: 6px;
  }

  .prose :global(pre) {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    overflow-x: auto;
    margin: 0 0 1.1rem;
  }

  .prose :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .prose :global(img) {
    max-width: 100%;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.25rem 0;
  }
</style>
