---
import { header } from "index.json";
import Section from "@/components/Section.astro";

const { title, description, image, alt } = header;
---

<Section>
  <div class="container">
    <img src={image} alt={alt} width="112" height="112" />
    <h1>{title}</h1>
    <p class="tagline">{description}</p>
  </div>
</Section>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 2px solid var(--border);
    box-shadow:
      0 0 0 6px rgba(45, 212, 191, 0.07),
      0 8px 32px rgba(0, 0, 0, 0.45);
  }

  h1 {
    padding-top: 1.25rem;
    font-size: 1.9rem;
    font-weight: 800;
  }

  .tagline {
    padding-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    text-wrap: pretty;
    max-width: 34ch;
    line-height: 1.55;
    margin: 0;
  }
</style>
