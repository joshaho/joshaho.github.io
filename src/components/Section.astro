---
const { title } = Astro.props;
---

<section>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 640px;
    margin: 0 auto 1.25rem;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 2rem 4px 0.75rem;
  }
</style>
