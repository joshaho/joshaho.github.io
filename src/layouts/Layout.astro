---
import { html, background } from "index.json";

interface Props {
  title?: string;
}

const { title: defaultTitle, lang, description, favicon } = html;
const { firstColor } = background;
const { title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={firstColor} />
    <title>{title ?? defaultTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Onest:wght@400..900&display=swap");

  :root {
    --bg: #0a0e14;
    --surface: rgba(255, 255, 255, 0.04);
    --surface-hover: rgba(255, 255, 255, 0.07);
    --border: rgba(255, 255, 255, 0.09);
    --border-hover: rgba(45, 212, 191, 0.45);
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --accent: #2dd4bf;
    --accent-soft: rgba(45, 212, 191, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: "Onest", sans-serif;
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg);
    background-image:
      radial-gradient(
        ellipse 90% 55% at 15% -10%,
        rgba(45, 212, 191, 0.13),
        transparent 62%
      ),
      radial-gradient(
        ellipse 65% 45% at 95% 108%,
        rgba(59, 130, 246, 0.09),
        transparent 60%
      );
    background-attachment: fixed;
    color: var(--text);
    min-height: 100vh;
    margin: 0;
    padding: clamp(2rem, 6vw, 4rem) 1.25rem;
    -webkit-font-smoothing: antialiased;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    letter-spacing: -0.02em;
  }

  ::selection {
    background: rgba(45, 212, 191, 0.3);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
